# ---------------------------------------------------------------------------
# Sandbox-only build workaround. See tools/sandbox-exec-shim.mjs for the full
# explanation.
#
# This DSH sandbox forbids subprocesses with piped stdio (spawn EPERM, -4048).
# On Windows Vite runs `net use` through child_process.exec to detect UNC
# network drives; that call throws EPERM synchronously and aborts `vite build`
# before Vite's own fallback can run. The shim turns that one optional probe
# into a normal async failure, so Vite takes the realpath-native fallback it
# already implements. No build output is affected.
#
# `node-options` makes npm/npx inject the shim, so a plain `npx vite build`
# works with no extra flags. Delete this file and tools/ on a machine whose
# sandbox allows piped stdio.
# ---------------------------------------------------------------------------
node-options=--import=./tools/sandbox-exec-shim.mjs

# npm's default cache lives outside the writable workspace and is denied with
# EPERM, so keep the cache next to the project root.
cache=../.npm-cache
