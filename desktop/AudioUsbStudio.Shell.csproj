<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AudioUsbStudio.Shell</RootNamespace>
    <AssemblyName>AudioUsbStudio</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      RuntimeIdentifier and SelfContained deliberately live on the publish command line
      in desktop/build-shell.mjs, not here. Setting them here would also make
      "dotnet run" against the test project build a self-contained tree, which is slow
      and pointless for running tests.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <!--
      desktop\tests is a separate project sitting inside this one's directory tree. Without
      this the shell would compile the test sources too and end up with two entry points.
    -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

</Project>
