# dependencies
node_modules/
web/node_modules/

# build output (regenerated by the build scripts)
build/
dist/
release/
web/dist/

# desktop shell build output
desktop/bin/
desktop/obj/
desktop/tests/bin/
desktop/tests/obj/
desktop/nuget-local/
desktop/NuGet.config

# local caches and logs
.npm-cache/
*.log

# scratch dirs from plan execution
_backup-*/
_shellprobe/

# yt-dlp's working directory when the engine runs from source, and the smoke
# script's download target (both live beside the app by design)
ytdlp-work/
.smoke-download-*/
